{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true
  },
  "include": ["src/main/**/*.cjs", "src/preload/**/*.cjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist", "release", "vendor", "tests", "build"]
}
