{
  "name": "zp-workstation",
  "version": "0.1.4",
  "description": "zp的工作站：Windows 上的 DeepSeek Harness 安装、更新与启动工具。",
  "main": "src/main/index.cjs",
  "author": "zp",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "preview:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run icons && npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run icons && npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@pnpm/exe.win32-x64": "12.4.2",
    "npm": "12.0.2",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "lucide": "1.47.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.4",
    "vite": "8.3.0",
    "wait-on": "9.1.0"
  },
  "launcherRelease": {
    "provider": "github",
    "owner": "",
    "repo": "",
    "assetPattern": "zp-Workstation-Setup-${version}-x64.exe"
  },
  "build": {
    "appId": "com.zp.workstation",
    "productName": "zp的工作站",
    "copyright": "Copyright © 2026 zp",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json",
      "node_modules/@pnpm/exe.win32-x64/**/*",
      "node_modules/semver/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@pnpm/exe.win32-x64/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "zp-Workstation-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "zp的工作站",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
