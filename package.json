{
  "name": "zp-workstation",
  "version": "0.3.2",
  "description": "ZP Workbench：面向本地学习与知识整理的 DeepSeek Harness 工作站。",
  "main": "src/main/index.cjs",
  "author": "zp",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "preview:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "icons": "node scripts/generate-icons.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "test": "node --test tests/*.test.cjs",
    "manifest": "node scripts/generate-update-manifest.mjs",
    "vendor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-vendor.ps1",
    "dist": "npm run vendor && npm run icons && npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run vendor && npm run icons && npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@pnpm/exe.win32-x64": "12.4.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.3",
    "morphicons": "1.7.1",
    "npm": "12.0.2",
    "pdfjs-dist": "^5.4.296",
    "semver": "7.8.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "lucide": "1.47.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.4",
    "vite": "8.3.0",
    "wait-on": "9.1.0"
  },
  "launcherRelease": {
    "provider": "github",
    "owner": "yuxhipeng-hub",
    "repo": "zp-workstation",
    "assetPattern": "ZP-Workbench-Setup-${version}-x64.exe",
    "manifestUrls": [
      {
        "id": "manifest-direct",
        "label": "GitHub 更新清单",
        "url": "https://github.com/yuxhipeng-hub/zp-workstation/releases/latest/download/latest.json"
      },
      {
        "id": "manifest-gh-proxy",
        "label": "国内加速更新清单",
        "url": "https://gh-proxy.com/https://github.com/yuxhipeng-hub/zp-workstation/releases/latest/download/latest.json"
      }
    ],
    "apiMirrors": [
      {
        "id": "github-api-gh-proxy",
        "label": "国内 GitHub API 加速",
        "prefix": "https://gh-proxy.com/"
      }
    ],
    "downloadMirrors": [
      {
        "id": "github-download-gh-proxy",
        "label": "国内 GitHub 下载加速",
        "prefix": "https://gh-proxy.com/"
      }
    ]
  },
  "bundledRuntime": {
    "node": "24.18.0",
    "npm": "12.0.2",
    "nodeMirror": "https://npmmirror.com/mirrors/node"
  },
  "build": {
    "appId": "com.zp.workstation",
    "productName": "ZP Workbench",
    "copyright": "Copyright © 2026 zp",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json",
      "node_modules/@pnpm/exe.win32-x64/**/*",
      "node_modules/jszip/**/*",
      "node_modules/mammoth/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/semver/**/*",
      "node_modules/xlsx/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@pnpm/exe.win32-x64/**/*"
    ],
    "publish": null,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ZP-Workbench-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZP Workbench",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
